# Entorno de ejecucion: development | production | test
NODE_ENV=development

# Puerto donde escucha la API
PORT=3000

# Conexion a PostgreSQL
DATABASE_URL="postgresql://postgres:TU_PASSWORD@localhost:5432/instituto?schema=public"

# Secreto para firmar los JWT. En produccion usar un valor largo y aleatorio:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiar-este-secreto-por-uno-largo-y-aleatorio
JWT_EXPIRES_IN=1d

# Origenes permitidos por CORS. "*" para cualquiera, o lista separada por comas:
# CORS_ORIGIN=http://localhost:5173,http://localhost:3001
CORS_ORIGIN=*

# Cloudinary - donde se suben las imagenes de los albums.
# El equipo comparte una sola cuenta: pedile las credenciales a quien la creo.
# Estan en el dashboard de Cloudinary, arriba de todo ("Product Environment Credentials").
# Sin estas tres el server no arranca.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Carpeta raiz dentro de Cloudinary (opcional). Cada album cuelga de aca con su id.
CLOUDINARY_FOLDER=instituto/albums
